<UserControl x:Class="Asher.UserInterface.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Asher.UserInterface.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!--  Welcome Header  -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Text="Welcome to Asher" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Your comprehensive modding platform for Dust: An Elysian Tail" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Quick Actions Grid  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Content Patcher Card  -->
                <materialDesign:Card Grid.Row="0"
                                     Grid.Column="0"
                                     Margin="0,0,12,12"
                                     Padding="20"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Cursor="Hand">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding NavigateToContentPatcherCommand}" MouseAction="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Width="48"
                                                 Height="48"
                                                 Margin="0,0,0,12"
                                                 HorizontalAlignment="Center"
                                                 Kind="ContentPaste" />
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Content Patcher" />
                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.7"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Text="Replace game assets and content"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <!--  Patch Manager Card  -->
                <materialDesign:Card Grid.Row="0"
                                     Grid.Column="1"
                                     Margin="12,0,0,12"
                                     Padding="20"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Cursor="Hand">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding NavigateToPatchManagerCommand}" MouseAction="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Width="48"
                                                 Height="48"
                                                 Margin="0,0,0,12"
                                                 HorizontalAlignment="Center"
                                                 Kind="Puzzle" />
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Patch Manager" />
                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.7"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Text="Manage runtime patches and mods"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <!--  Settings Card  -->
                <materialDesign:Card Grid.Row="1"
                                     Grid.Column="0"
                                     Margin="0,12,12,0"
                                     Padding="20"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Cursor="Hand">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding NavigateToSettingsCommand}" MouseAction="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Width="48"
                                                 Height="48"
                                                 Margin="0,0,0,12"
                                                 HorizontalAlignment="Center"
                                                 Kind="Settings" />
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Settings" />
                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.7"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Text="Configure application preferences"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <!--  Launch Game Card  -->
                <materialDesign:Card Grid.Row="1"
                                     Grid.Column="1"
                                     Margin="12,12,0,0"
                                     Padding="20"
                                     materialDesign:ElevationAssist.Elevation="Dp2"
                                     Cursor="Hand">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding Command="{Binding LaunchGameCommand}" MouseAction="LeftClick" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Width="48"
                                                 Height="48"
                                                 Margin="0,0,0,12"
                                                 HorizontalAlignment="Center"
                                                 Kind="Play" />
                        <TextBlock Margin="0,0,0,8"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Launch Game" />
                        <TextBlock HorizontalAlignment="Center"
                                   Opacity="0.7"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   Text="Start Dust: An Elysian Tail with mods"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>