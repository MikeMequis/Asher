<UserControl x:Class="Asher.UserInterface.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Asher.UserInterface.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="White">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Welcome Header -->
            <materialDesign:Card Margin="0,0,0,24"
                                 Padding="24">
                <StackPanel>
                    <TextBlock Text="Welcome to Asher"
                               Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Your comprehensive modding platform for Dust: An Elysian Tail"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Opacity="0.7" />
                </StackPanel>
            </materialDesign:Card>

            <!-- Quick Actions Grid -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Content Patcher Card -->
                <materialDesign:Card Grid.Column="0"
                                     Grid.Row="0"
                                     Margin="0,0,12,12"
                                     Padding="20"
                                     Cursor="Hand"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToContentPatcherCommand}" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="ContentPaste"
                                                 Width="48"
                                                 Height="48"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,12" />
                        <TextBlock Text="Content Patcher"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Replace game assets and content"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Patch Manager Card -->
                <materialDesign:Card Grid.Column="1"
                                     Grid.Row="0"
                                     Margin="12,0,0,12"
                                     Padding="20"
                                     Cursor="Hand"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToPatchManagerCommand}" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Puzzle"
                                                 Width="48"
                                                 Height="48"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,12" />
                        <TextBlock Text="Patch Manager"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Manage runtime patches and mods"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Settings Card -->
                <materialDesign:Card Grid.Column="0"
                                     Grid.Row="1"
                                     Margin="0,12,12,0"
                                     Padding="20"
                                     Cursor="Hand"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding NavigateToSettingsCommand}" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Settings"
                                                 Width="48"
                                                 Height="48"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,12" />
                        <TextBlock Text="Settings"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Configure application preferences"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>

                <!-- Launch Game Card -->
                <materialDesign:Card Grid.Column="1"
                                     Grid.Row="1"
                                     Margin="12,12,0,0"
                                     Padding="20"
                                     Cursor="Hand"
                                     materialDesign:ElevationAssist.Elevation="Dp2">
                    <materialDesign:Card.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding LaunchGameCommand}" />
                    </materialDesign:Card.InputBindings>
                    <StackPanel>
                        <materialDesign:PackIcon Kind="Play"
                                                 Width="48"
                                                 Height="48"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,12" />
                        <TextBlock Text="Launch Game"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Start Dust: An Elysian Tail with mods"
                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.7" />
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>