<UserControl x:Class="Asher.UserInterface.Views.InstallationResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" VerticalAlignment="Center">
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="{Binding HeaderTitle}" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="{Binding HeaderSubtitle}" />
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="32" Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <materialDesign:PackIcon Width="80"
                                              Height="80"
                                              Margin="0,0,0,24"
                                              HorizontalAlignment="Center"
                                              Foreground="Green"
                                              Kind="CheckCircle" />

                    <TextBlock Margin="0,0,0,16"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Medium"
                               Text="{Binding ReadyTitle}" />

                    <TextBlock Margin="0,0,0,24"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Text="{Binding ResultMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <CheckBox Margin="0,0,0,16"
                              HorizontalAlignment="Center"
                              Content="{Binding CreateShortcutLabel}"
                              IsChecked="{Binding CreateDesktopShortcut}"
                              Style="{StaticResource MaterialDesignCheckBox}" />

                    <StackPanel>
                        <Button Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Command="{Binding FinishInstallationCommand}"
                                Content="{Binding FinishLabel}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Padding="32" Visibility="{Binding IsSuccess, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <materialDesign:PackIcon Width="80"
                                              Height="80"
                                              Margin="0,0,0,24"
                                              HorizontalAlignment="Center"
                                              Foreground="Red"
                                              Kind="AlertCircle" />

                    <TextBlock Margin="0,0,0,16"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Medium"
                               Text="{Binding ErrorHeading}" />

                    <TextBlock Margin="0,0,0,24"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Text="{Binding ResultMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <Border Margin="0,0,0,24"
                            Background="{DynamicResource MaterialDesignDivider}"
                            CornerRadius="4"
                            Padding="16"
                            Visibility="{Binding HasErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       FontWeight="Medium"
                                       Text="{Binding ErrorDetailsLabel}" />
                            <TextBlock FontFamily="Consolas"
                                       Opacity="0.7"
                                       Text="{Binding ErrorDetails}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Center">
                        <Button Margin="0,0,0,8"
                                Command="{Binding RetryInstallationCommand}"
                                Content="{Binding RetryLabel}"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Command="{Binding CancelInstallationCommand}"
                                Content="{Binding CancelLabel}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Margin="0,16,0,0"
                                 Padding="16"
                                 Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12"
                               FontWeight="Medium"
                               Text="{Binding NextStepsLabel}" />
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Margin="0,0,0,4"
                                   Opacity="0.7"
                                   Text="{Binding StepModsLabel}" />
                        <TextBlock Margin="0,0,0,4"
                                   Opacity="0.7"
                                   Text="{Binding StepContentPatcherLabel}" />
                        <TextBlock Opacity="0.7"
                                   Text="{Binding StepEnjoyLabel}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
