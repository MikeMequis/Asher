<UserControl x:Class="Asher.UserInterface.Views.InstallationResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" VerticalAlignment="Center">
            <!--  Header  -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="{Binding HeaderTitle}" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="{Binding HeaderSubtitle}" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Success Result  -->
            <materialDesign:Card Padding="32" Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center">
                    <!--  Success Icon  -->
                    <materialDesign:PackIcon Width="80"
                                              Height="80"
                                              Margin="0,0,0,24"
                                              HorizontalAlignment="Center"
                                              Foreground="Green"
                                              Kind="CheckCircle" />

                    <!--  Success Message  -->
                    <TextBlock Margin="0,0,0,16"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Medium"
                               Text="O Asher está pronto!" />

                    <TextBlock Margin="0,0,0,32"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Text="{Binding ResultMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <!--  Success Actions  -->
                    <StackPanel>
                        <Button Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                Command="{Binding FinishInstallationCommand}"
                                Content="COMEÇAR A USAR"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!--  Error Result  -->
            <materialDesign:Card Padding="32" Visibility="{Binding IsSuccess, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel>
                    <!--  Error Icon  -->
                    <materialDesign:PackIcon Width="80"
                                              Height="80"
                                              Margin="0,0,0,24"
                                              HorizontalAlignment="Center"
                                              Foreground="Red"
                                              Kind="AlertCircle" />

                    <!--  Error Message  -->
                    <TextBlock Margin="0,0,0,16"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="Medium"
                               Text="Falha na instalação" />

                    <TextBlock Margin="0,0,0,24"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Text="{Binding ResultMessage}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />

                    <!--  Error Details  -->
                    <Border Margin="0,0,0,24"
                            Background="{DynamicResource MaterialDesignDivider}"
                            CornerRadius="4"
                            Padding="16"
                            Visibility="{Binding HasErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Margin="0,0,0,8"
                                       FontWeight="Medium"
                                       Text="Detalhes do erro:" />
                            <TextBlock FontFamily="Consolas"
                                       Opacity="0.7"
                                       Text="{Binding ErrorDetails}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Error Actions  -->
                    <StackPanel HorizontalAlignment="Center">
                        <Button Margin="0,0,0,8"
                                Command="{Binding RetryInstallationCommand}"
                                Content="TENTAR NOVAMENTE"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                        <Button Command="{Binding CancelInstallationCommand}"
                                Content="CANCELAR"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

            <!--  Additional Info (Success only)  -->
            <materialDesign:Card Margin="0,16,0,0"
                                 Padding="16"
                                 Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,12"
                               FontWeight="Medium"
                               Text="Próximos passos:" />
                    <StackPanel Margin="8,0,0,0">
                        <TextBlock Margin="0,0,0,4" Opacity="0.7">
                            <Run Text="•" />
                            <Run Text="Adicione mods na pasta" />
                            <Run FontWeight="Medium" Text="patches" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" Opacity="0.7">
                            <Run Text="•" />
                            <Run Text="Use o Content Patcher para gerenciar patches" />
                        </TextBlock>
                        <TextBlock Opacity="0.7">
                            <Run Text="•" />
                            <Run Text="Aproveite seu jogo modificado!" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
