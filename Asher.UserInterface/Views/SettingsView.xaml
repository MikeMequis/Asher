<UserControl x:Class="Asher.UserInterface.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Asher.UserInterface.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Text="Settings"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Configure application preferences and game settings"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Game Settings -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Game Settings"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Game Path -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Game Executable Path"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Path to DustAET.exe"
                                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                     Width="300"
                                     Margin="0,0,8,0"/>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Browse"
                                    Command="{Binding BrowseGamePathCommand}"/>
                        </StackPanel>
                        
                        <!-- Auto Launch -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Auto-launch with patches"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,16,16,0"/>
                        
                        <ToggleButton Grid.Row="1" Grid.Column="1"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding AutoLaunchEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="0,16,0,0"/>
                        
                        <!-- Backup Enabled -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Enable automatic backups"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,16,16,0"/>
                        
                        <ToggleButton Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding BackupEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="0,16,0,0"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Application Settings -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Application Settings"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Language -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Language"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="200"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"/>
                        
                        <!-- Theme -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Theme"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,16,16,0"/>
                        
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Width="200"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Margin="0,16,0,0"/>
                        
                        <!-- Check for Updates -->
                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Check for updates on startup"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   VerticalAlignment="Center"
                                   Margin="0,16,16,0"/>
                        
                        <ToggleButton Grid.Row="2" Grid.Column="1"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                      IsChecked="{Binding CheckForUpdatesEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="0,16,0,0"/>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- Actions -->
            <materialDesign:Card Padding="24">
                <StackPanel>
                    <TextBlock Text="Actions"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Content="Reset to Defaults"
                                Command="{Binding ResetToDefaultsCommand}"
                                Margin="0,0,8,0"/>
                        <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                Content="Save Settings"
                                Command="{Binding SaveSettingsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
