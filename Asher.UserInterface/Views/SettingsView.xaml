<UserControl x:Class="Asher.UserInterface.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Asher.UserInterface.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!--  Header  -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="Settings" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Configure application preferences and game settings" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Game Settings  -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Game Settings" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Game Path  -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Game Executable Path" />

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                            <TextBox Width="300"
                                     Margin="0,0,8,0"
                                     materialDesign:HintAssist.Hint="Path to DustAET.exe"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding BrowseGamePathCommand}"
                                    Content="Browse"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <!--  Auto Launch  -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,16,16,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Auto-launch with patches" />

                        <ToggleButton Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,16,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding AutoLaunchEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />

                        <!--  Backup Enabled  -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,16,16,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Enable automatic backups" />

                        <ToggleButton Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,16,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding BackupEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!--  Application Settings  -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Application Settings" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Language  -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,16,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Language" />

                        <ComboBox Grid.Row="0"
                                  Grid.Column="1"
                                  Width="200"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <!--  Theme  -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Margin="0,16,16,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Theme" />

                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  Width="200"
                                  Margin="0,16,0,0"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" />

                        <!--  Check for Updates  -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Margin="0,16,16,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="Check for updates on startup" />

                        <ToggleButton Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,16,0,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding CheckForUpdatesEnabled}"
                                      Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!--  Actions  -->
            <materialDesign:Card Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Actions" />

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Margin="0,0,8,0"
                                Command="{Binding ResetToDefaultsCommand}"
                                Content="Reset to Defaults"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        <Button Command="{Binding SaveSettingsCommand}"
                                Content="Save Settings"
                                Style="{StaticResource MaterialDesignRaisedButton}" />
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
