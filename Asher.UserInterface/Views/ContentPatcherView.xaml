<UserControl x:Class="Asher.UserInterface.Views.ContentPatcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Asher.UserInterface.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!-- Header -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Text="Content Patcher"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="Replace game assets and content without modifying original files"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Opacity="0.7"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Content Patching Section -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Asset Replacement"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Original Asset -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Original Asset"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Asset path (e.g., Characters/Fidget)"
                                     Text="{Binding OriginalAssetPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Browse Original"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        
                        <!-- Arrow -->
                        <materialDesign:PackIcon Grid.Column="1" 
                                                 Kind="ArrowRight"
                                                 Width="24" Height="24"
                                                 VerticalAlignment="Center"
                                                 Margin="8,0"/>
                        
                        <!-- Replacement Asset -->
                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                            <TextBlock Text="Replacement Asset"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Margin="0,0,0,8"/>
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Replacement file path"
                                     Text="{Binding ReplacementAssetPath, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,8"/>
                            <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Content="Browse Replacement"
                                    HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>
                    
                    <Button Style="{StaticResource MaterialDesignRaisedButton}"
                            Content="Add Replacement"
                            Command="{Binding AddReplacementCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,16,0,0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Active Replacements -->
            <materialDesign:Card Padding="24">
                <StackPanel>
                    <TextBlock Text="Active Replacements"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,16"/>
                    
                    <TextBlock Text="No active replacements configured"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               HorizontalAlignment="Center"
                               Opacity="0.5"
                               Margin="32"/>
                    
                    <TextBlock Text="Replacements will be applied when the game is launched"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
