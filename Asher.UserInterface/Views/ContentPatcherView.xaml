<UserControl x:Class="Asher.UserInterface.Views.ContentPatcherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Asher.UserInterface.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!--  Header  -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="Content Patcher" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Replace game assets and content without modifying original files" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Content Patching Section  -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Asset Replacement" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Original Asset  -->
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Margin="0,0,0,8"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Text="Original Asset" />
                            <TextBox Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Asset path (e.g., Characters/Fidget)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding OriginalAssetPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Browse Original"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <!--  Arrow  -->
                        <materialDesign:PackIcon Grid.Column="1"
                                                 Width="24"
                                                 Height="24"
                                                 Margin="8,0"
                                                 VerticalAlignment="Center"
                                                 Kind="ArrowRight" />

                        <!--  Replacement Asset  -->
                        <StackPanel Grid.Column="2" Margin="16,0,0,0">
                            <TextBlock Margin="0,0,0,8"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Text="Replacement Asset" />
                            <TextBox Margin="0,0,0,8"
                                     materialDesign:HintAssist.Hint="Replacement file path"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Text="{Binding ReplacementAssetPath, UpdateSourceTrigger=PropertyChanged}" />
                            <Button HorizontalAlignment="Stretch"
                                    Content="Browse Replacement"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                    </Grid>

                    <Button Margin="0,16,0,0"
                            HorizontalAlignment="Right"
                            Command="{Binding AddReplacementCommand}"
                            Content="Add Replacement"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Active Replacements  -->
            <materialDesign:Card Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Active Replacements" />

                    <TextBlock Margin="32"
                               HorizontalAlignment="Center"
                               Opacity="0.5"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Text="No active replacements configured" />

                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               Opacity="0.7"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               Text="Replacements will be applied when the game is launched" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
