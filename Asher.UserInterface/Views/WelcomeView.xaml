<UserControl x:Class="Asher.UserInterface.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!--  Header  -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="Bem-vindo ao Asher" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Prepare Dust: An Elysian Tail para suporte a mods" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Main Content  -->
            <materialDesign:Card Margin="0,0,0,16" Padding="32">
                <StackPanel>
                    <TextBlock Margin="0,0,0,24"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               TextAlignment="Center"
                               TextWrapping="Wrap">
                        <Run FontWeight="Medium" Text="O Asher irá preparar Dust: An Elysian Tail para suporte a mods." />
                    </TextBlock>

                    <!--  Info Items  -->
                    <StackPanel Margin="0,0,0,32">
                        <Border Margin="0,0,0,12"
                                Background="{DynamicResource MaterialDesignDivider}"
                                CornerRadius="4"
                                Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="24"
                                                          Height="24"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                          Kind="ContentSave" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                                           Text="Um backup dos arquivos originais será criado automaticamente" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource MaterialDesignDivider}"
                                CornerRadius="4"
                                Padding="16">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="24"
                                                          Height="24"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                          Kind="FileEdit" />
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                                           Text="Os arquivos do jogo serão modificados para permitir mods" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Action Button  -->
                    <Button HorizontalAlignment="Center"
                            Command="{Binding BeginInstallationCommand}"
                            Content="COMEÇAR"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Additional Info  -->
            <materialDesign:Card Padding="16">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Width="20"
                                              Height="20"
                                              Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource MaterialDesignBodyLight}"
                                              Kind="Information" />
                    <TextBlock VerticalAlignment="Center"
                               Opacity="0.6"
                               Style="{StaticResource MaterialDesignBody2TextBlock}"
                               Text="Este processo é necessário apenas uma vez"
                               TextWrapping="Wrap" />
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
