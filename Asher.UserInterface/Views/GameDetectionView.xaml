<UserControl x:Class="Asher.UserInterface.Views.GameDetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <!--  Header  -->
            <materialDesign:Card Margin="0,0,0,24" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                               Text="Detectar Jogo" />
                    <TextBlock Opacity="0.7"
                               Style="{StaticResource MaterialDesignBody1TextBlock}"
                               Text="Localize a pasta de instalação do Dust: An Elysian Tail" />
                </StackPanel>
            </materialDesign:Card>

            <!--  Detection Card  -->
            <materialDesign:Card Margin="0,0,0,16" Padding="24">
                <StackPanel>
                    <TextBlock Margin="0,0,0,16"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="Localização do Jogo" />

                    <!--  Auto Detection  -->
                    <Button Margin="0,0,0,16"
                            HorizontalAlignment="Left"
                            Command="{Binding DetectGameFolderCommand}"
                            Content="DETECTAR AUTOMATICAMENTE"
                            IsEnabled="{Binding IsDetecting, Converter={StaticResource InverseBooleanConverter}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}">
                        <Button.CommandParameter>
                            <materialDesign:PackIcon Kind="Magnify" />
                        </Button.CommandParameter>
                    </Button>

                    <!--  Path Display  -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="Caminho da pasta do jogo"
                                 IsReadOnly="True"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Text="{Binding GameFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Grid.Column="1"
                                Command="{Binding BrowseCommand}"
                                Content="PROCURAR..."
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </Grid>

                    <!--  Status Display  -->
                    <Border Padding="16"
                            Background="{DynamicResource MaterialDesignDivider}"
                            CornerRadius="4"
                            Visibility="{Binding HasGameInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <!--  Valid Game Found  -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsGameValid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Width="24"
                                                          Height="24"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="Green"
                                                          Kind="CheckCircle" />
                                <StackPanel>
                                    <TextBlock FontWeight="Medium" Text="Jogo encontrado com sucesso!" />
                                    <TextBlock Margin="0,4,0,0"
                                               Opacity="0.7"
                                               Text="{Binding GameVersion, StringFormat='Versão: {0}'}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Opacity="0.7"
                                               Text="{Binding GameSource, StringFormat='Fonte: {0}'}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Invalid Game Folder  -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding IsGameValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <materialDesign:PackIcon Width="24"
                                                          Height="24"
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="Orange"
                                                          Kind="AlertCircle" />
                                <StackPanel>
                                    <TextBlock FontWeight="Medium" Text="Pasta inválida" />
                                    <TextBlock Margin="0,4,0,0"
                                               Opacity="0.7"
                                               Text="DustAET.exe não foi encontrado nesta pasta"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </materialDesign:Card>

            <!--  Action Buttons  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Command="{Binding ContinueCommand}"
                        Content="CONTINUAR"
                        IsEnabled="{Binding IsGameValid}"
                        Style="{StaticResource MaterialDesignRaisedButton}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
