<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x86</Platforms>
    <PlatformTarget Condition="'$(OS)' == 'Windows_NT' AND '$(Platform)' == 'x86'">x86</PlatformTarget>
    <AssemblyName>Asher.Host</AssemblyName>
    <RootNamespace>Asher.Host</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Asher.Core\Asher.Core.csproj" />
    <ProjectReference Include="..\Asher.Services\Asher.Services.csproj" />
  </ItemGroup>

  <Import Project="InstallPayload.targets" Condition="'$(OS)' == 'Windows_NT' AND '$(RuntimeIdentifier)' == ''" />

</Project>
